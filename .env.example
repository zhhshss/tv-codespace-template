# 复制为 .env 并按需修改（不要提交真实密钥）
# 在 devcontainer 里可通过 Codespaces secrets 注入同名变量。

# 仓库与分支
TV_REPO=https://github.com/wobuhui666/TV.git
TV_REF=sync/fongmi-20260628
TV_UI_REF=ui/apple-tv-redesign
MEDIA_REPO=https://github.com/wobuhui666/media.git
MEDIA_REF=release-1.11.0-fongmi

# Android SDK / 模拟器
ANDROID_HOME=/workspaces/android-sdk
ANDROID_AVD_HOME=/workspaces/TV-ui-runtime/avd
TV_AVD_NAME=tv_ui_api24
TV_EMULATOR_PORT=5580
TV_AVD_DATA_SIZE=2G
TV_EMULATOR_TIMEOUT=240
TV_FIXTURE_PORT=8765
# 真机测试时填写真机能访问的宿主地址
# TV_FIXTURE_BASE=http://<宿主IP>:8765

# 启动 Codespace 时自动拉起模拟器 + fixture（1 开启，默认 0）
TV_AUTOSTART=0

# GitHub（私有仓库/推送需要）
# GH_TOKEN=

# Tailscale（真机/容器测试设备联调）
# TS_AUTHKEY=

# 签名（release 构建；见 TV 仓库 LOCAL_BUILD_ENV.md）
# 本地会生成 release.jks + local.properties，无需在此配置
# TMDB_API_KEY=
